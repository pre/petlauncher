<?xml version="1.0" encoding="UTF-8"?>
<!--
  The keys of the GNOME custom shortcuts that petlauncher-gnome uses, for the
  tests. The test the_installed_schema_has_the_keys_of_the_test_schema
  compares them with the installed schema of gnome-settings-daemon.
-->
<schemalist>
  <schema id="org.gnome.settings-daemon.plugins.media-keys"
          path="/org/gnome/settings-daemon/plugins/media-keys/">
    <key name="custom-keybindings" type="as">
      <default>[]</default>
    </key>
  </schema>
  <schema id="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding">
    <key name="name" type="s">
      <default>''</default>
    </key>
    <key name="binding" type="s">
      <default>''</default>
    </key>
    <key name="command" type="s">
      <default>''</default>
    </key>
  </schema>
</schemalist>
